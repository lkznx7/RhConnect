
// ============================================================
// ENUMS
// ============================================================

Enum perfil_usuario {
  CANDIDATO
  COLABORADOR
  ADMIN
}

Enum status_vaga {
  RASCUNHO
  PUBLICADA
  EM_PROCESSO
  ENCERRADA
}

Enum status_candidatura {
  NOVOS_INSCRITOS
  TRIAGEM
  ENTREVISTA_RH
  ESTUDO_CASO
  ENTREVISTA_LIDERANCA
  PROPOSTA
  REPROVADO
  DESISTENTE
}

Enum modalidade_curso {
  EAD_SINCRONO
  PRESENCIAL
  HIBRIDO
  AUTOINSTRUCIONAL
}

Enum status_curso {
  RASCUNHO
  PUBLICADO
  EM_ANDAMENTO
  CONCLUIDO
}

Enum status_inscricao_curso {
  PENDENTE_APROVACAO
  APROVADA
  EM_ANDAMENTO
  CONCLUIDA
  REPROVADA
}

Enum tipo_noticia {
  ARTIGO
  PORTARIA
  AVISO
}

Enum status_noticia {
  RASCUNHO
  PUBLICADA
  ARQUIVADA
}

Enum setor_ouvidoria {
  DP_FOLHA
  BENEFICIOS
  RECRUTAMENTO
  TREINAMENTO
  OUVIDORIA
}

Enum tipo_categoria {
  VAGAS
  CURSOS
  NOTICIAS
}

// ============================================================
// TABELA DE USUÁRIOS (unificada — todos os perfis)
// ============================================================

// Modelo único de usuário. Os campos são opcionais (nullable) e apenas
// relevantes conforme o perfil:
//   - CANDIDATO:   data_nascimento, genero, pcd, cidade, uf, email_profissional,
//                  area_interesse, nivel_senioridade, expectativa_salarial,
//                  modalidade_trabalho_preferida, resumo_carreira, linkedin_url,
//                  portfolio_url, curriculo_arquivo_url
//   - COLABORADOR: matricula, cargo, departamento, gestor_imediato_id,
//                  email_corporativo, data_admissao
Table usuario {
  id uuid [pk, default: `gen_random_uuid()`]
  nome_completo varchar(255) [not null]
  email varchar(255) [not null, unique]
  cpf varchar(14) [not null, unique]
  telefone_whatsapp varchar(15) [not null]
  senha_hash varchar(255) [not null]
  perfil perfil_usuario [not null]
  objetivo_rh_connect varchar(255) [not null]
  ativo boolean [not null, default: true]
  criado_em timestamp [not null, default: `now()`]
  atualizado_em timestamp [not null, default: `now()`]

  // --- Campos de CANDIDATO (nullable) ---
  data_nascimento date
  genero varchar(50)
  pcd boolean [default: false]
  cidade varchar(100)
  uf char(2)
  email_profissional varchar(255)
  area_interesse varchar(255)
  nivel_senioridade varchar(50)
  expectativa_salarial numeric(12, 2)
  modalidade_trabalho_preferida varchar(50)
  resumo_carreira text
  linkedin_url varchar(500)
  portfolio_url varchar(500)
  curriculo_arquivo_url varchar(500)

  // --- Campos de COLABORADOR (nullable) ---
  matricula varchar(50) [unique]
  cargo varchar(150)
  departamento varchar(150)
  gestor_imediato_id uuid
  email_corporativo varchar(255) [unique]
  data_admissao date

  Note: 'Usuário de autenticação, acesso e perfil unificado por role'
}

// ============================================================
// ESTRUTURA DO CURRÍCULO
// ============================================================

Table curriculo {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid [not null, unique]
  resumo_profissional text
  arquivo_url varchar(500)
  criado_em timestamp [not null, default: `now()`]
  atualizado_em timestamp [not null, default: `now()`]

  Note: 'Currículo estruturado atrelado ao usuário candidato'
}

Table experiencia_profissional {
  id uuid [pk, default: `gen_random_uuid()`]
  curriculo_id uuid [not null]
  cargo varchar(255) [not null]
  empresa varchar(255) [not null]
  data_inicio date [not null]
  data_fim date
  trabalho_atual boolean [not null, default: false]
  descricao text
  criado_em timestamp [not null, default: `now()`]

  Note: 'Histórico profissional cronológico'
}

Table formacao_academica {
  id uuid [pk, default: `gen_random_uuid()`]
  curriculo_id uuid [not null]
  curso varchar(255) [not null]
  instituicao varchar(255) [not null]
  nivel varchar(100) [not null]
  data_inicio date [not null]
  data_conclusao date
  em_andamento boolean [not null, default: false]
  criado_em timestamp [not null, default: `now()`]

  Note: 'Graduações, pós e especializações'
}

Table curso_certificacao {
  id uuid [pk, default: `gen_random_uuid()`]
  curriculo_id uuid [not null]
  nome varchar(255) [not null]
  instituicao varchar(255)
  ano_conclusao integer
  carga_horaria_horas integer
  criado_em timestamp [not null, default: `now()`]

  Note: 'Certificações extracurriculares'
}

Table competencia {
  id uuid [pk, default: `gen_random_uuid()`]
  curriculo_id uuid [not null]
  nome varchar(255) [not null]
  nivel varchar(50)
  criado_em timestamp [not null, default: `now()`]

  Note: 'Soft e hard skills'
}

Table idioma {
  id uuid [pk, default: `gen_random_uuid()`]
  curriculo_id uuid [not null]
  idioma varchar(100) [not null]
  nivel varchar(50) [not null]
  criado_em timestamp [not null, default: `now()`]

  Note: 'Proficiência em idiomas'
}

// ============================================================
// RECRUTAMENTO E SELEÇÃO
// ============================================================

Table vaga {
  id uuid [pk, default: `gen_random_uuid()`]
  titulo varchar(255) [not null]
  descricao text [not null]
  responsabilidades text [not null]
  requisitos_obrigatorios text [not null]
  diferenciais text
  beneficios text [not null]
  etapas_processo text [not null]
  campus varchar(255) [not null]
  area varchar(255) [not null]
  tipo_contrato varchar(100) [not null]
  modalidade_trabalho varchar(100) [not null]
  numero_edital varchar(50) [not null, unique]
  status status_vaga [not null, default: 'RASCUNHO']
  criado_por uuid [not null]
  criado_em timestamp [not null, default: `now()`]
  atualizado_em timestamp [not null, default: `now()`]

  Note: 'Oportunidades de emprego abertas'
}

Table candidatura {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid [not null]
  vaga_id uuid [not null]
  protocolo varchar(50) [not null, unique]
  status status_candidatura [not null, default: 'NOVOS_INSCRITOS']
  data_candidatura timestamp [not null, default: `now()`]
  atualizado_em timestamp [not null, default: `now()`]

  indexes {
    (usuario_id, vaga_id) [unique]
  }

  Note: 'Inscrição de candidato em processos seletivos'
}

// ============================================================
// EDUCAÇÃO CORPORATIVA
// ============================================================

Table curso_corporativo {
  id uuid [pk, default: `gen_random_uuid()`]
  titulo varchar(255) [not null]
  descricao text [not null]
  area_conhecimento varchar(255) [not null]
  modalidade modalidade_curso [not null]
  nivel_proficiencia varchar(100) [not null]
  instrutor varchar(255) [not null]
  ementa text [not null]
  metodologia text [not null]
  corpo_docente text
  configuracoes_turma jsonb [not null]
  material_didatico_url varchar(500)
  status status_curso [not null, default: 'RASCUNHO']
  criado_por uuid [not null]
  criado_em timestamp [not null, default: `now()`]
  atualizado_em timestamp [not null, default: `now()`]

  Note: 'Catálogo de treinamentos internos'
}

Table inscricao_curso {
  id uuid [pk, default: `gen_random_uuid()`]
  curso_id uuid [not null]
  usuario_id uuid [not null]
  aprovador_id uuid
  status status_inscricao_curso [not null, default: 'PENDENTE_APROVACAO']
  progresso_porcentagem integer [not null, default: 0]
  codigo_inscricao varchar(50) [not null, unique]
  data_inscricao timestamp [not null, default: `now()`]

  indexes {
    (curso_id, usuario_id) [unique]
  }

  Note: 'Inscrição de colaboradores em treinamentos corporativos'
}

// ============================================================
// COMUNICAÇÃO E CONTEÚDO
// ============================================================

Table noticia {
  id uuid [pk, default: `gen_random_uuid()`]
  titulo varchar(255) [not null]
  corpo text [not null]
  imagem_capa_url varchar(500)
  tipo tipo_noticia [not null]
  status status_noticia [not null, default: 'RASCUNHO']
  criado_por uuid [not null]
  criado_em timestamp [not null, default: `now()`]
  atualizado_em timestamp [not null, default: `now()`]

  Note: 'Artigos, portarias e comunicados corporativos'
}

Table anexo_noticia {
  id uuid [pk, default: `gen_random_uuid()`]
  noticia_id uuid [not null]
  topico varchar(255) [not null]
  data date [not null]
  status varchar(100) [not null]
  arquivo_url varchar(500) [not null]
  criado_em timestamp [not null, default: `now()`]

  Note: 'Documentos anexos a publicações'
}

Table categoria {
  id uuid [pk, default: `gen_random_uuid()`]
  nome varchar(255) [not null]
  tipo tipo_categoria [not null]
  criado_em timestamp [not null, default: `now()`]

  Note: 'Classificações taxonômicas compartilhadas'
}

Table noticia_tag {
  noticia_id uuid [not null]
  tag_id uuid [not null]

  indexes {
    (noticia_id, tag_id) [pk]
  }

  Note: 'Pivot N:N de tags em notícias'
}

Table vaga_categoria {
  vaga_id uuid [not null]
  categoria_id uuid [not null]

  indexes {
    (vaga_id, categoria_id) [pk]
  }

  Note: 'Pivot N:N entre vagas e categorias'
}

Table curso_categoria {
  curso_id uuid [not null]
  categoria_id uuid [not null]

  indexes {
    (curso_id, categoria_id) [pk]
  }

  Note: 'Pivot N:N entre cursos e categorias'
}

// ============================================================
// INSTITUCIONAL E CONFIGURAÇÃO
// ============================================================

Table configuracao_sistema {
  id integer [pk, default: 1]
  nome_empresa varchar(255) [not null]
  logo_url varchar(500)
  notificacao_email_imediata boolean [not null, default: true]
  feedback_automatico boolean [not null, default: true]
  conformidade_lgpd text
  atualizado_em timestamp [not null, default: `now()`]

  indexes {
    id [unique]
  }

  Note: 'Parâmetros operacionais globais (tabela singleton)'
}

Table contato_ouvidoria {
  id uuid [pk, default: `gen_random_uuid()`]
  nome_completo varchar(255) [not null]
  email_institucional varchar(255) [not null]
  setor_destino setor_ouvidoria [not null]
  matricula varchar(50)
  assunto varchar(255) [not null]
  mensagem text [not null]
  criado_em timestamp [not null, default: `now()`]

  Note: 'Atendimentos enviados à ouvidoria interna'
}

Table newsletter_inscricao {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  criado_em timestamp [not null, default: `now()`]

  Note: 'Mailing list para comunicados públicos'
}

// ============================================================
// RELACIONAMENTOS (FOREIGN KEYS)
// ============================================================

// Auto-referência: gestor imediato de colaborador (1:N)
Ref: usuario.gestor_imediato_id > usuario.id

// Currículo do Candidato (1:1)
Ref: curriculo.usuario_id - usuario.id

// Elementos do Currículo (1:N)
Ref: experiencia_profissional.curriculo_id > curriculo.id
Ref: formacao_academica.curriculo_id > curriculo.id
Ref: curso_certificacao.curriculo_id > curriculo.id
Ref: competencia.curriculo_id > curriculo.id
Ref: idioma.curriculo_id > curriculo.id

// Auditoria e Autoria (N:1)
Ref: vaga.criado_por > usuario.id
Ref: curso_corporativo.criado_por > usuario.id
Ref: noticia.criado_por > usuario.id

// Vagas e Inscrições
Ref: candidatura.usuario_id > usuario.id
Ref: candidatura.vaga_id > vaga.id

// Treinamentos Internos
Ref: inscricao_curso.curso_id > curso_corporativo.id
Ref: inscricao_curso.usuario_id > usuario.id
Ref: inscricao_curso.aprovador_id > usuario.id

// Documentos e Categorizações
Ref: anexo_noticia.noticia_id > noticia.id

// Pivots N:N
Ref: noticia_tag.noticia_id > noticia.id
Ref: noticia_tag.tag_id > categoria.id

Ref: vaga_categoria.vaga_id > vaga.id
Ref: vaga_categoria.categoria_id > categoria.id

Ref: curso_categoria.curso_id > curso_corporativo.id
Ref: curso_categoria.categoria_id > categoria.id
